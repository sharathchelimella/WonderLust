<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-3">
  <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
    <h3 class="mb-3 text-start fw-bold"><%= listing.title %></h3>
  </div>

  <div class="card col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3 show-card listing-card shadow-sm border-0 rounded-4 overflow-hidden">
    <% let imgUrl = typeof listing.image === 'string' ? listing.image : (listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=800&q=60'); %>
    <img 
      src="<%= imgUrl %>" 
      class="card-img-top show-img" 
      alt="listing_image"
    >
    <div class="card-body p-3">
      <p class="card-text">
        <span class="d-block mb-3 text-secondary lh-base"><%= listing.description %></span>
        <span class="d-block mb-2 fs-5">
          <strong class="text-dark">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></strong> <span class="fs-6 text-muted">/ night</span>
        </span>
        <span class="d-block text-muted">
          <i class="fa-solid fa-location-dot text-danger me-2"></i><%= listing.location %>, <%= listing.country %>
        </span>
      </p>
    </div>
  </div>

  <div class="col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3 btns my-3 d-flex align-items-center gap-3">
    <a href="/listing/<%= listing._id %>/edit" class="btn btn-dark edit-btn px-4 py-2">Edit</a>
    <form method="POST" action="/listing/<%= listing._id %>?_method=DELETE" class="d-inline m-0">
      <button class="btn btn-dark px-4 py-2 rounded-3 delete-btn">Delete</button>
    </form>
  </div>
</div>
