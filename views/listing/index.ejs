<% layout("/layouts/boilerplate.ejs") %>

<h3 class="mt-3 mb-4 fw-bold">Explore Listings</h3>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
    <% for(let list of alllisting){ %>
        <div class="col">
            <a href="/listings/<%= list._id %>" class="listing-link text-decoration-none text-dark">
                <div class="card listing-card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                    <div class="position-relative">
                        <img 
                            src="<%= typeof list.image === 'string' ? list.image : (list.image && list.image.url ? list.image.url : 'https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=800&q=60') %>" 
                            class="card-img-top listing-card-img" 
                            alt="listing_image" 
                            style="height: 18rem; object-fit: cover;"
                        />
                        <div class="card-img-overlay"></div>
                    </div>
                    <div class="card-body p-3">
                        <h5 class="card-title fw-bold fs-6 mb-1 text-truncate"><%= list.title %></h5>
                        <p class="card-text text-muted mb-0">
                            <strong class="text-dark">&#8377; <%= list.price != null ? list.price.toLocaleString("en-IN") : "N/A" %></strong> / night
                        </p>
                    </div> 
                </div>
            </a>
        </div>
    <% } %>
</div>